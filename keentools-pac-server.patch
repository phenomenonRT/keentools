new file mode 100755
index 0000000..b9e6a19
--- /dev/null
+++ b/modules/pac-server/log.sh
@@ -0,0 +1,6 @@
+#!/bin/sh
+if command -v systemctl >/dev/null 2>&1; then
+    journalctl -u pac-server -n 50 --no-pager 2>/dev/null && exit 0
+fi
+echo "На Entware/OpenWrt pac-server не пишет отдельный лог-файл."
+echo "Проверьте, что процесс жив: ps | grep pac-server"
diff --git a/modules/pac-server/restart.sh b/modules/pac-server/restart.sh
new file mode 100755
index 0000000..20db524
--- /dev/null
+++ b/modules/pac-server/restart.sh
@@ -0,0 +1,11 @@
+#!/bin/sh
+if [ -x /opt/etc/init.d/S99pac-server ]; then
+    /opt/etc/init.d/S99pac-server restart
+elif [ -x /etc/init.d/pac-server ]; then
+    /etc/init.d/pac-server restart
+elif command -v systemctl >/dev/null 2>&1; then
+    systemctl restart pac-server
+else
+    echo "Не найден init-скрипт/сервис pac-server"
+    exit 1
+fi
